<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NativeAssetsPath>$(MSBuildThisFileDirectory)build/Release/</NativeAssetsPath>
  </PropertyGroup>
  <PropertyGroup>
    <PackageId>Sakura.Framework.SPIRV</PackageId>
    <Authors>HelloYeew</Authors>
    <Copyright>Copyright (c) 2026 HelloYeew</Copyright>
    <Description>Self-contained GLSL and SPIR-V compilation and SPIR-V cross-compilation libraries that are usable cross-platform</Description>
    <PackageTags>spirv glsl hlsl msl essl metal shader cross-compile gpu sakura framework</PackageTags>
    <RepositoryUrl>https://github.com/HelloYeew/sakura-spirv</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/HelloYeew/sakura-spirv</PackageProjectUrl>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <None Include="../icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!-- NuGet pack entries -->
  <ItemGroup>
    <None Include="$(NativeAssetsPath)win-x64/libsakura-spirv.dll" Condition="Exists('$(NativeAssetsPath)win-x64/libsakura-spirv.dll')">
      <PackagePath>runtimes/win-x64/native</PackagePath>
      <Pack>true</Pack>
    </None>
    <None Include="$(NativeAssetsPath)win-x86/libsakura-spirv.dll" Condition="Exists('$(NativeAssetsPath)win-x86/libsakura-spirv.dll')">
      <PackagePath>runtimes/win-x86/native</PackagePath>
      <Pack>true</Pack>
    </None>
    <None Include="$(NativeAssetsPath)win-arm64/libsakura-spirv.dll" Condition="Exists('$(NativeAssetsPath)win-arm64/libsakura-spirv.dll')">
      <PackagePath>runtimes/win-arm64/native</PackagePath>
      <Pack>true</Pack>
    </None>
    <None Include="$(NativeAssetsPath)osx/libsakura-spirv.dylib" Condition="Exists('$(NativeAssetsPath)osx/libsakura-spirv.dylib')">
      <PackagePath>runtimes/osx/native</PackagePath>
      <Pack>true</Pack>
    </None>
    <None Include="$(NativeAssetsPath)linux-x64/libsakura-spirv.so" Condition="Exists('$(NativeAssetsPath)linux-x64/libsakura-spirv.so')">
      <PackagePath>runtimes/linux-x64/native</PackagePath>
      <Pack>true</Pack>
    </None>
    <None Include="$(NativeAssetsPath)linux-arm64/libsakura-spirv.so" Condition="Exists('$(NativeAssetsPath)linux-arm64/libsakura-spirv.so')">
      <PackagePath>runtimes/linux-arm64/native</PackagePath>
      <Pack>true</Pack>
    </None>
    <None Include="$(NativeAssetsPath)ios/**/*.xcframework/**/*" Condition="Exists('$(NativeAssetsPath)ios/')">
      <PackagePath>runtimes/ios/native/sakura-spirv.xcframework</PackagePath>
      <Pack>true</Pack>
    </None>
    <None Include="$(NativeAssetsPath)android-arm/libsakura-spirv.so" Condition="Exists('$(NativeAssetsPath)android-arm/libsakura-spirv.so')">
      <PackagePath>runtimes/android-arm/native</PackagePath>
      <Pack>true</Pack>
    </None>
    <None Include="$(NativeAssetsPath)android-arm64/libsakura-spirv.so" Condition="Exists('$(NativeAssetsPath)android-arm64/libsakura-spirv.so')">
      <PackagePath>runtimes/android-arm64/native</PackagePath>
      <Pack>true</Pack>
    </None>
    <None Include="$(NativeAssetsPath)android-x64/libsakura-spirv.so" Condition="Exists('$(NativeAssetsPath)android-x64/libsakura-spirv.so')">
      <PackagePath>runtimes/android-x64/native</PackagePath>
      <Pack>true</Pack>
    </None>
    <None Include="$(NativeAssetsPath)android-x86/libsakura-spirv.so" Condition="Exists('$(NativeAssetsPath)android-x86/libsakura-spirv.so')">
      <PackagePath>runtimes/android-x86/native</PackagePath>
      <Pack>true</Pack>
    </None>
  </ItemGroup>

  <!--
    Copy the current platform native to the output after build.
    This uses a Target (not Content items) so it propagates to referencing projects
    like test projects via GetCopyToOutputDirectoryItems.
  -->
  <Target Name="CopyNativeLibrary" AfterTargets="Build">
    <PropertyGroup>
      <_NativeFile Condition="$([MSBuild]::IsOSPlatform('OSX'))">$(NativeAssetsPath)osx/libsakura-spirv.dylib</_NativeFile>
      <_NativeFile Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64'">$(NativeAssetsPath)win-x64/libsakura-spirv.dll</_NativeFile>
      <_NativeFile Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X86'">$(NativeAssetsPath)win-x86/libsakura-spirv.dll</_NativeFile>
      <_NativeFile Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">$(NativeAssetsPath)win-arm64/libsakura-spirv.dll</_NativeFile>
      <_NativeFile Condition="$([MSBuild]::IsOSPlatform('Linux')) And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64'">$(NativeAssetsPath)linux-x64/libsakura-spirv.so</_NativeFile>
      <_NativeFile Condition="$([MSBuild]::IsOSPlatform('Linux')) And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">$(NativeAssetsPath)linux-arm64/libsakura-spirv.so</_NativeFile>
    </PropertyGroup>
    <Copy
      SourceFiles="$(_NativeFile)"
      DestinationFolder="$(OutputPath)"
      Condition="'$(_NativeFile)' != '' And Exists('$(_NativeFile)')"
      SkipUnchangedFiles="true" />
  </Target>

  <!--
    Also hook into GetCopyToOutputDirectoryItems so the native is included when
    a referencing project (e.g. the test project) copies its dependencies.
  -->
  <Target Name="IncludeNativeInReferencingProjects" BeforeTargets="GetCopyToOutputDirectoryItems">
    <PropertyGroup>
      <_NativeFile Condition="$([MSBuild]::IsOSPlatform('OSX'))">$(NativeAssetsPath)osx/libsakura-spirv.dylib</_NativeFile>
      <_NativeFile Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64'">$(NativeAssetsPath)win-x64/libsakura-spirv.dll</_NativeFile>
      <_NativeFile Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X86'">$(NativeAssetsPath)win-x86/libsakura-spirv.dll</_NativeFile>
      <_NativeFile Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">$(NativeAssetsPath)win-arm64/libsakura-spirv.dll</_NativeFile>
      <_NativeFile Condition="$([MSBuild]::IsOSPlatform('Linux')) And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64'">$(NativeAssetsPath)linux-x64/libsakura-spirv.so</_NativeFile>
      <_NativeFile Condition="$([MSBuild]::IsOSPlatform('Linux')) And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">$(NativeAssetsPath)linux-arm64/libsakura-spirv.so</_NativeFile>
    </PropertyGroup>
    <ItemGroup Condition="'$(_NativeFile)' != '' And Exists('$(_NativeFile)')">
      <ContentWithTargetPath Include="$(_NativeFile)">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <TargetPath>$([System.IO.Path]::GetFileName('$(_NativeFile)'))</TargetPath>
      </ContentWithTargetPath>
    </ItemGroup>
  </Target>
</Project>
